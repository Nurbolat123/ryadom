{
  "name": "ryadom",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @ryadom/web dev",
    "dev:realtime": "pnpm --filter @ryadom/realtime dev",
    "dev:bot": "pnpm --filter @ryadom/bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @ryadom/db generate",
    "db:migrate": "pnpm --filter @ryadom/db migrate:dev",
    "db:deploy": "pnpm --filter @ryadom/db migrate:deploy",
    "db:seed": "pnpm --filter @ryadom/db seed",
    "db:reset": "pnpm --filter @ryadom/db reset",
    "db:studio": "pnpm --filter @ryadom/db studio",
    "admin:grant": "pnpm --filter @ryadom/db run admin grant",
    "admin:revoke": "pnpm --filter @ryadom/db run admin revoke",
    "venues:import": "pnpm --filter @ryadom/venues run import",
    "venues:suggestions": "pnpm --filter @ryadom/venues run suggestions"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
