# Продакшен-настройки: скопируй в .env в корне проекта на сервере и заполни.
#   cp deploy/env.production.example .env && nano .env
# Проверка, чего не хватает (значения не печатаются):
#   docker compose -f docker-compose.prod.yml run --rm tools
# Сервисы с ошибками в настройках не запускаются и пишут причину в журнал.

# --- Адрес сайта ---
# Домен, направленный A-записью на сервер. Caddy сам выпустит HTTPS-сертификат.
DOMAIN=ryadom.kz
PUBLIC_URL=https://ryadom.kz
WEB_ORIGIN=https://ryadom.kz

# --- База (внутри docker-compose; адрес собирается сам) ---
# Пароль — только латиница и цифры: openssl rand -hex 24
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=
POSTGRES_DB=ryadom

# --- Защита ---
# Случайная строка для хэшей в лимитах: openssl rand -hex 32. Не менять после запуска.
RATE_LIMIT_SALT=

# --- SMS с кодом входа ---
# Провайдер выбирается до запуска (нужна реализация SmsProvider).
# Для закрытого теста на своём сервере: SMS_PROVIDER=console и ALLOW_CONSOLE_SMS=1 —
# коды пишутся в журнал web (docker compose logs web), на экран не выводятся.
SMS_PROVIDER=
ALLOW_CONSOLE_SMS=

# --- Селфи-проверка ---
# Провайдер выбирается до запуска. Для закрытого теста: VERIFICATION_PROVIDER=stub и
# ALLOW_STUB_VERIFICATION=1 (одобряет любое селфи).
VERIFICATION_PROVIDER=
ALLOW_STUB_VERIFICATION=

# --- Фото профиля: S3-совместимое хранилище в Казахстане (правило 12) ---
PHOTO_STORAGE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Оплата: Kaspi Pay (данные выдаются при подключении мерчанта) ---
PAYMENT_PROVIDER=kaspi
KASPI_API_URL=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=

# --- Web Push ---
# Создаются один раз командой из deploy/README.md (шаг «Ключи Web Push») и потом не меняются:
# после смены всем придётся заново включить уведомления.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ryadom.kz

# --- Telegram-бот заведений (пусто — бот не запускается) ---
TELEGRAM_BOT_TOKEN=

# --- Бизнес-настройки ---
PLATFORM_COMMISSION_PCT=12
DEFAULT_MAX_GIFT_AMOUNT=500000
OVERPASS_URL=https://overpass-api.de/api/interpreter
