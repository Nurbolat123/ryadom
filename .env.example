# Скопируй в .env: cp .env.example .env
# Секреты только в .env, этот файл без реальных значений.

# --- База данных (docker-compose) ---
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=ryadom_dev_password
POSTGRES_DB=ryadom
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ryadom:ryadom_dev_password@localhost:5432/ryadom?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Приложения ---
WEB_PORT=3000
REALTIME_PORT=4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Откуда realtime принимает подключения (через запятую)
WEB_ORIGIN=http://localhost:3000

# --- Telegram-бот заведений (этап 8) ---
# Токен от @BotFather. Без него бот не стартует, остальное приложение работает.
TELEGRAM_BOT_TOKEN=

# --- Оплата (этапы 8–9) ---
# stub — заглушка, деньги не списываются (в продакшене не запустится); kaspi — Kaspi Pay.
PAYMENT_PROVIDER=stub
# Заглушка: redirect — тестовая страница «Оплатить / Отменить» (как у Kaspi), instant — оплата сразу.
STUB_PAYMENT_MODE=redirect
# Адрес сайта для возврата с оплаты (для Kaspi обязателен, https)
PUBLIC_URL=
# Kaspi Pay: выдаются при подключении мерчанта. Уведомления об оплате — на
# ${PUBLIC_URL}/api/payments/webhook/kaspi, подпись HMAC-SHA256 тела в заголовке x-signature.
KASPI_API_URL=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=

# --- Бизнес-настройки ---
# Комиссия платформы с подарка, % (по умолчанию 12)
PLATFORM_COMMISSION_PCT=12
# Максимальная стоимость подарка по умолчанию, в тиынах (5000 ₸)
DEFAULT_MAX_GIFT_AMOUNT=500000

# --- Импорт заведений (этап 2) ---
# Сервер Overpass API (можно зеркало или свой)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Rate limits ---
# Соль для хэширования IP в ключах лимитов (любая случайная строка)
RATE_LIMIT_SALT=change-me

# --- Вход и профиль (этап 3) ---
# SMS: console — заглушка, код пишется в лог сервера (в продакшене запрещена)
SMS_PROVIDER=console
# Селфи-проверка: stub — заглушка, одобряет любое селфи (в продакшене запрещена)
VERIFICATION_PROVIDER=stub
# Хранилище фото: local — папка на диске (в продакшене — S3 в Казахстане)
PHOTO_STORAGE=local
# Абсолютный путь; по умолчанию .data/photos в корне проекта
PHOTO_STORAGE_DIR=
